<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/rh"/>
            <size
                android:height="80dp"
                android:width="80dp"/>
            <stroke
                android:width="3dp"
                android:color="@color/rh"/>
            <stroke
                android:width="25dp"
                android:color="#0000ffff"/>
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="oval">
            <solid android:color="@color/qe"/>
            <size
                android:height="80dp"
                android:width="80dp"/>
            <stroke
                android:width="3dp"
                android:color="@color/qe"/>
            <stroke
                android:width="25dp"
                android:color="#0000ffff"/>
        </shape>
    </item>
</selector>
