<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/a3"
    android:layout_width="match_parent"
    android:layout_height="?style/k">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/az"
                android:id="@attr/ct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONE SHIELD "/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/dh"
                android:id="@attr/a0z"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PLUS"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/dh"
                android:id="@attr/a0x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Config V: "/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@attr/qk"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginRight="10dp"
        android:tint="@color/az"
        android:layout_centerVertical="true"
        android:layout_marginStart="15dp"
        app:a15="@drawable/hy"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:id="@attr/a10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IP: "
        android:layout_centerVertical="true"
        android:layout_toEndOf="@attr/qk"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:id="@attr/nq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="127.0.0.1"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@attr/a10"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/cx"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:paddingStart="5dp"
        android:paddingEnd="15dp"
        android:layout_marginEnd="15dp">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/az"
            android:gravity="center"
            android:id="@attr/a1c"
            android:background="@drawable/cx"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="30dp"
            android:text="0m"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
</RelativeLayout>
