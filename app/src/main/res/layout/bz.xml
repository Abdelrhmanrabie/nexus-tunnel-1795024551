<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@attr/ls"
        android:background="@color/b9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payload Generator"
            android:layout_weight="1"/>
        <View
            android:id="@attr/fh"
            android:background="@drawable/fn"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@attr/ls">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/b9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="URL/Host"/>
                <EditText
                    android:id="@attr/a2p"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="m.beeg.com"
                    android:ems="10"
                    android:inputType="textUri"/>
                <TextView
                    android:textColor="@color/b9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Split Mode"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@attr/z4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:weightSum="3">
                    <RadioButton
                        android:id="@attr/z5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instant"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:id="@attr/z3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delay"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:id="@attr/z6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:layout_weight="1"/>
                </RadioGroup>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:weightSum="2">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textColor="@color/b9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Request Method"/>
                        <Spinner
                            android:id="@attr/vl"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_alignParentRight="true">
                        <TextView
                            android:textColor="@color/b9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Injection Method"/>
                        <Spinner
                            android:id="@attr/nn"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textColor="@color/b9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Query Mode"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@attr/v9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Front Query"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back Query"
                        android:layout_weight="1"/>
                </RadioGroup>
                <TextView
                    android:textColor="@color/b9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extra Headers"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:weightSum="2">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <CheckBox
                            android:id="@attr/th"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Online-Host"/>
                        <CheckBox
                            android:id="@attr/vo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reverse-Proxy"/>
                        <CheckBox
                            android:id="@attr/u0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Proxy-Authorization"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <CheckBox
                            android:id="@attr/lm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Forward-Host"/>
                        <CheckBox
                            android:id="@attr/oe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keep-Alive"/>
                        <CheckBox
                            android:id="@attr/j2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dual-Connect"/>
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:textColor="#ffffff"
                    android:id="@attr/lr"
                    android:background="@color/b9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GENERATE"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
