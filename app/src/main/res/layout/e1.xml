<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:orientation="horizontal"
            android:id="@attr/sv"
            android:background="?style/gn"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textSize="12sp"
                android:id="@attr/sm"
                android:background="@drawable/nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:button="@null"
                android:text="All Tweaks"/>
            <RadioButton
                android:textSize="12sp"
                android:id="@attr/sn"
                android:background="@drawable/nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:button="@null"
                android:text="Mobily"/>
            <RadioButton
                android:textSize="12sp"
                android:id="@attr/so"
                android:background="@drawable/nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:button="@null"
                android:text="Zain"/>
            <RadioButton
                android:textSize="12sp"
                android:id="@attr/sp"
                android:background="@drawable/nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:button="@null"
                android:text="STC"/>
            <RadioButton
                android:textSize="12sp"
                android:id="@attr/sq"
                android:background="@drawable/nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:button="@null"
                android:text="UAE"/>
            <RadioButton
                android:textSize="12sp"
                android:id="@attr/st"
                android:background="@drawable/nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:button="@null"
                android:text="Qatar"/>
            <RadioButton
                android:textSize="12sp"
                android:id="@attr/sr"
                android:background="@drawable/nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:button="@null"
                android:text="Oman"/>
            <RadioButton
                android:textSize="12sp"
                android:id="@attr/ss"
                android:background="@drawable/nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="KSA"/>
            <RadioButton
                android:textSize="12sp"
                android:id="@attr/su"
                android:background="@drawable/nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="BD"/>
        </RadioGroup>
    </HorizontalScrollView>
    <ListView
        android:id="@attr/sh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"/>
</LinearLayout>
