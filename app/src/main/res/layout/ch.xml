<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/br"
        app:di="5dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="?style/zq"
            android:padding="@dimen/ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/p2">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="@plurals/mn"
                        android:id="@attr/d2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:minLines="1"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textAppearance="@plurals/ml"
                        android:textSize="12sp"
                        android:id="@attr/d3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lines="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@attr/os"
                android:background="?style/zr"
                android:padding="@dimen/ok"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="@dimen/p3"
                    android:layout_height="@dimen/p3"
                    app:a15="@drawable/gc"/>
            </LinearLayout>
            <LinearLayout
                android:id="@attr/oy"
                android:background="?style/zr"
                android:padding="@dimen/ok"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="@dimen/p3"
                    android:layout_height="@dimen/p3"
                    app:a15="@drawable/fz"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
