<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.google.android.material.textfield.TextInputEditText
                    android:textAppearance="@plurals/h3"
                    android:id="@attr/gb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Network Name"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textColor="@color/az"
                android:id="@attr/a10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Select Protocol"
                android:layout_weight="1"/>
            <Spinner
                android:entries="@array/j"
                android:id="@attr/gw"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginBottom="10dp"/>
            <RadioGroup
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@attr/gm"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:textSize="10sp"
                    android:id="@attr/va"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HTTP"/>
                <RadioButton
                    android:textSize="10sp"
                    android:id="@attr/vb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SSL/TLS"/>
            </RadioGroup>
            <LinearLayout
                android:orientation="vertical"
                android:id="@attr/nm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@attr/gl"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@attr/gk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Sni"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@attr/gd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.textfield.TextInputEditText
                            android:textAppearance="@plurals/h3"
                            android:id="@attr/gc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Payload"
                            android:maxLines="8"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <ImageButton
                        android:id="@attr/gj"
                        android:background="@drawable/co"
                        android:visibility="visible"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        app:a15="@drawable/gt"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@attr/gg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/b9"
                        android:gravity="center_horizontal"
                        android:id="@attr/a11"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Use mode below"/>
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@attr/u1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:checkedButton="@attr/t3">
                        <RadioButton
                            android:textSize="12sp"
                            android:id="@attr/t3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Normal DNS"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:textSize="12sp"
                            android:id="@attr/fk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cloudfront"
                            android:layout_weight="1"/>
                        <RadioButton
                            android:textSize="12sp"
                            android:id="@attr/vc"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ProxyServer"
                            android:layout_weight="1"/>
                    </RadioGroup>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputEditText
                                android:textAppearance="@plurals/h3"
                                android:id="@attr/gf"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Proxy"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="165dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputEditText
                                android:textAppearance="@plurals/h3"
                                android:id="@attr/gh"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Proxy Port"
                                android:inputType="number"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <CheckBox
                        android:layout_gravity="end"
                        android:id="@attr/g9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use Default Proxy"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@attr/a2y"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="10dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@plurals/a38">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@attr/c7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="200dp"
                        android:hint="V2RAY Config"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@attr/in"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@attr/g_"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter dnstt resolver"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.google.android.material.textfield.TextInputEditText
                    android:textAppearance="@plurals/h3"
                    android:id="@attr/ga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Network Message"
                    android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <Button
                android:id="@attr/ge"
                android:background="@drawable/co"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="CREATE"
                android:textAllCaps="false"/>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
