<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/az"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Select Protocol"
            android:layout_weight="1"/>
        <Spinner
            android:entries="@array/j"
            android:id="@attr/ha"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginBottom="10dp"/>
        <RadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@attr/hn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textSize="10sp"
                android:id="@attr/va"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HTTP"/>
            <RadioButton
                android:textSize="10sp"
                android:id="@attr/vb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SSL/TLS"/>
        </RadioGroup>
        <LinearLayout
            android:orientation="vertical"
            android:id="@attr/nm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@attr/he"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@attr/hd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Sni"/>
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@attr/gz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textAppearance="@plurals/h3"
                        android:id="@attr/gy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Payload"
                        android:maxLines="8"/>
                </com.google.android.material.textfield.TextInputLayout>
                <ImageButton
                    android:id="@attr/hc"
                    android:background="@drawable/co"
                    android:visibility="visible"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:a15="@drawable/gt"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@attr/h7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.textfield.TextInputEditText
                            android:textAppearance="@plurals/h3"
                            android:id="@attr/h6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Proxy"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="165dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <com.google.android.material.textfield.TextInputEditText
                            android:textAppearance="@plurals/h3"
                            android:id="@attr/h8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Proxy Port"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <CheckBox
                    android:layout_gravity="end"
                    android:id="@attr/gu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use Default Proxy"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@attr/a2y"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@plurals/a38">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@attr/a2x"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Bug Host"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <RadioGroup
                android:orientation="horizontal"
                android:id="@attr/a32"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@attr/a31">
                <RadioButton
                    android:id="@attr/a31"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WS SSL/TLS"
                    android:layout_weight="1"/>
                <RadioButton
                    android:id="@attr/a2z"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NON TLS"
                    android:layout_weight="1"/>
            </RadioGroup>
            <CheckBox
                android:id="@attr/a30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reverse Address"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@attr/in"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:l5="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@attr/gv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter dnstt resolver"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <Button
            android:id="@attr/h3"
            android:background="@drawable/co"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textAllCaps="false"/>
    </LinearLayout>
</RelativeLayout>
