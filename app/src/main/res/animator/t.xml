<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="@integer/ab"
                android:valueTo="@dimen/k8"
                android:valueType="floatType"
                android:propertyName="translationZ"/>
            <objectAnimator
                android:duration="0"
                android:valueTo="@dimen/jw"
                android:valueType="floatType"
                android:propertyName="elevation"/>
        </set>
    </item>
    <item
        android:state_enabled="true"
        android:state_hovered="true">
        <set>
            <objectAnimator
                android:duration="@integer/ab"
                android:valueTo="@dimen/jy"
                android:valueType="floatType"
                android:propertyName="translationZ"/>
            <objectAnimator
                android:duration="0"
                android:valueTo="@dimen/jw"
                android:valueType="floatType"
                android:propertyName="elevation"/>
        </set>
    </item>
    <item
        android:state_focused="true"
        android:state_enabled="true">
        <set>
            <objectAnimator
                android:duration="@integer/ab"
                android:valueTo="@dimen/jx"
                android:valueType="floatType"
                android:propertyName="translationZ"/>
            <objectAnimator
                android:duration="0"
                android:valueTo="@dimen/jw"
                android:valueType="floatType"
                android:propertyName="elevation"/>
        </set>
    </item>
    <item android:state_enabled="true">
        <set>
            <objectAnimator
                android:duration="@integer/ab"
                android:valueTo="@dimen/ke"
                android:valueType="floatType"
                android:propertyName="translationZ"
                android:startDelay="@integer/aa"/>
            <objectAnimator
                android:duration="0"
                android:valueTo="@dimen/jw"
                android:valueType="floatType"
                android:propertyName="elevation"/>
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="0"
                android:valueTo="@dimen/jv"
                android:valueType="floatType"
                android:propertyName="translationZ"/>
            <objectAnimator
                android:duration="0"
                android:valueTo="@dimen/ju"
                android:valueType="floatType"
                android:propertyName="elevation"/>
        </set>
    </item>
</selector>
