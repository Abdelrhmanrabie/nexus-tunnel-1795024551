plugins {
    id 'com.android.application'
}

android {
    namespace "org.hamotunnelplus.xyz"
    compileSdk 35

    defaultConfig {
        applicationId 'org.hamotunnelplus.xyz'
        minSdk 23
        targetSdk 35
        versionCode 15
        versionName "1.5"
        vectorDrawables.useSupportLibrary = true

        testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
    }

    buildTypes {
        release {
            minifyEnabled false
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_1_8
        targetCompatibility JavaVersion.VERSION_1_8
    }

    lintOptions {
        abortOnError false
    }

    buildFeatures {
        buildConfig = false
    }

    aaptOptions {
        threadCount = 1
    }
}

dependencies {
    // TODO: dependencies
}
